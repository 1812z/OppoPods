    <string name="le_audio_summary">连接策略、双耳保活与 OPPO 协议兼容</string>
    <string name="le_audio_enable">启用 OPPO LE Audio</string>
    <string name="le_audio_enable_summary">启用完整连接兼容链路。升级后先重启蓝牙，再回盒重开盖；只开启系统 LC3 可能关闭经典/HFP，导致 AT 握手无法触发。</string>
    <string name="le_audio_protocol">高级设置 · OPPO 私有协议兼容</string>
    <string name="le_audio_at">应答厂商 AT 指令</string>
    <string name="le_audio_at_summary">按 OPPO 协议应答 VDID / VDSF / OESF / VDSP 询问</string>
    <string name="le_audio_vdsp">下发 +VDSP=1,1</string>
    <string name="le_audio_vdsp_summary">HFP 握手完成后 500 毫秒下发 LE Audio 初始化</string>
    <string name="le_audio_vendor_id">厂商标识 Vendor ID</string>
    <string name="le_audio_vendor_id_summary">OPPO 厂商标识，默认 1946（十进制，0–65535）</string>
    <string name="le_audio_oesf_mask">OESF 功能掩码</string>
    <string name="le_audio_oesf_mask_summary">与耳机请求的特性按位与，默认 0x3f（十进制或十六进制，0–65535）</string>
    <string name="le_audio_save_protocol">保存协议参数</string>
    <string name="le_audio_reset">恢复高级设置默认值</string>
    <string name="le_audio_latency_group">延迟与性能</string>
    <string name="le_audio_connection_group">连接策略与调度</string>
    <string name="le_audio_stability_group">链路保活与稳定性</string>
    <string name="le_audio_game_context">全局低延迟</string>
    <string name="le_audio_game_context_summary">默认关闭。宣告游戏状态以参与低延迟协商，可能降低码率和音质；实际档位取决于系统配置，播放后可能被系统复位。</string>
    <string name="le_audio_le_first">LE Audio 连接优先</string>
    <string name="le_audio_le_first_summary">经典来向事件先给 LE 一次连接机会，失败后本轮放行经典；不全局强制双模。</string>
    <string name="le_audio_poke">主动发起 LE 握手</string>
    <string name="le_audio_poke_summary">在 LE 优先的来向事件中直接触发一次连接，不轮询、不反复补拨。</string>
    <string name="le_audio_wake_classic">蓝牙重启后补拨经典</string>
    <string name="le_audio_wake_classic_summary">服务就绪或系统自动回连时，向经典主耳补一次全量连接；恢复 HFP 初始化通道。不会在合盖后的断开事件里拨经典。</string>
    <string name="le_audio_fix_policy">修复连接策略锁死</string>
    <string name="le_audio_fix_policy_summary">拦截系统内部 FORBIDDEN 回写，并在连接前修复 A2DP/HFP 策略，避免 LC3 开启后 AT 通道被封死。本进程识别用户关闭的项；旧进程遗留的禁用策略可能被修复。</string>
    <string name="le_audio_gate_hfp">LE 优先时拦截 HFP</string>
    <string name="le_audio_gate_hfp_summary">默认关闭，请保持关闭。Enco X3 主耳依赖 HFP/AT 协调双耳；开启可能让握手不触发或只有单耳出声。</string>
    <string name="le_audio_hold_gatt">保持 GATT 链路持有</string>
    <string name="le_audio_hold_gatt_summary">LE ACL 建立后挂载 direct GATT 持有者，防止闲置拆链造成单耳断联。可能增加功耗；手动断开、ACL 断开或关闭功能时释放。</string>
    <string name="le_audio_complete_group">补齐双耳 LE Audio 连接</string>
    <string name="le_audio_complete_group_summary">首耳连上或缺失耳失败时，同组仍在线则直接补缺失成员一次；不把 Java 已连接状态当作双耳链路稳定的保证。</string>
    <string name="le_audio_adopt_contexts">补全可用音频上下文</string>
    <string name="le_audio_adopt_contexts_summary">恢复参考模块的空上下文修复和双耳就绪后的主耳激活；优先使用该组 native 上报，系统已填入非零值时不覆盖。</string>
    <string name="le_audio_devices">选择介入设备</string>
    <string name="le_audio_devices_count">已选择 %1$d 个 MAC 地址；未选择时不介入任何设备</string>
    <string name="le_audio_devices_hint">选择需要 LE Audio 兼容的已配对耳机。按 MAC 地址判断，同组经典/双耳 LE 地址由系统关联，不再匹配设备名称。</string>
    <string name="le_audio_devices_permission">授予蓝牙设备权限</string>
    <string name="le_audio_devices_save">保存</string>
    <string name="le_audio_saved_device">已保存设备（当前不在配对列表）</string>
